  "item": [
    {
      "name": "01 - Create Car",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/cars",
        "description": "Creates a unique test car and generates test dates for later requests.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"brand\": \"Toyota\",\n  \"model\": \"Avanza QA\",\n  \"plateNumber\": \"{{testPlate}}\",\n  \"dailyRate\": 350000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Generate unique data for each full Collection Runner execution.",
              "const now = new Date();",
              "const start = new Date(now.getTime());",
              "start.setUTCDate(start.getUTCDate() + 14);",
              "const end = new Date(start.getTime());",
              "end.setUTCDate(end.getUTCDate() + 2); // inclusive 3 calendar days",
              "const fmt = d => `${d.getUTCFullYear()}-${String(d.getUTCMonth()+1).padStart(2,'0')}-${String(d.getUTCDate()).padStart(2,'0')}`;",
              "pm.collectionVariables.set('testPlate', 'PMT' + Date.now());",
              "pm.collectionVariables.set('testStartDate', fmt(start));",
              "pm.collectionVariables.set('testEndDate', fmt(end));",
              "pm.collectionVariables.set('testDailyRate', '350000');",
              "pm.collectionVariables.set('testCustomerEmail', 'qa-' + Date.now() + '@example.com');",
              "pm.collectionVariables.unset('carId');",
              "pm.collectionVariables.unset('rentalId');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test(\"Create car returns 201 Created\", () => pm.expect(pm.response.code).to.eql(201));",
              "pm.test(\"Envelope is successful\", () => pm.expect(json.success).to.eql(true));",
              "pm.test(\"Car has an ID and AVAILABLE status\", () => { pm.expect(json.data.id).to.exist; pm.expect(json.data.status).to.eql('AVAILABLE'); });",
              "pm.test(\"Daily rate matches request\", () => pm.expect(Number(json.data.dailyRate)).to.eql(350000));",
              "pm.collectionVariables.set('carId', String(json.data.id));",
              "pm.collectionVariables.set('carName', json.data.brand + ' ' + json.data.model);"
            ]
          }
        }
      ]
    },
